# .env.example — TDM Platform environment variable reference
# Copy to .env for local development. Never commit .env to version control.
# Uvicorn reads this file only when started with --env-file .env.

# ─── Authentication ────────────────────────────────────────────────────────────
# Auth mode: "production" (default) requires a real JWT.
# "development" accepts X-Dev-User / X-Dev-Roles headers instead.
# DO NOT set development in production environments.
TDM_AUTH_MODE=development

# JWT settings (required when TDM_AUTH_MODE=production)
# HMAC-SHA256 secret key.  Generate with: python -c "import secrets; print(secrets.token_hex(32))"
# For RS256/OIDC use TDM_OIDC_ISSUER instead.
TDM_JWT_SECRET=REPLACE_WITH_RANDOM_SECRET_NEVER_COMMIT_THIS
TDM_JWT_ALGORITHM=HS256

# Optional: restrict token acceptance to specific issuer and audience.
TDM_JWT_ISSUER=https://your-oidc-provider.example.com
TDM_JWT_AUDIENCE=tdm-platform

# ─── Database ────────────────────────────────────────────────────────────────
# Where metadata_store.db lives. Defaults to project root.
# On persistent-disk hosting (Render, Railway, etc.) set this to the mount path.
# TDM_DATA_DIR=/data

# ─── CORS ────────────────────────────────────────────────────────────────────
# Comma-separated allowed origins for the frontend.
TDM_ALLOWED_ORIGINS=http://localhost:5500,http://127.0.0.1:5500,http://localhost:5173,http://127.0.0.1:5173,http://localhost:4173,http://127.0.0.1:4173

# ─── Logging / Retention ─────────────────────────────────────────────────────
TDM_LOG_RETENTION_DAYS=5

# ─── Connector Security ───────────────────────────────────────────────────────
# If set, only these hosts can be connected to via the DB connector.
# TDM_ALLOWED_DB_HOSTS=db.internal.example.com,10.0.0.5
TDM_ALLOWED_DB_HOSTS=localhost,127.0.0.1